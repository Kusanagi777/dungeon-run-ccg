## Factory for Run Structure and Reward Draft fixtures.
## Generated by /test-helpers on 2026-11-03.
## Based on: design/gdd/run-structure.md R1 (RunState), R3 (MatchConfig), F1
## (band), F4 (deck size), Acceptance Criteria fixtures (6/6/4 boss pool);
## design/gdd/reward-draft.md D1 (Offer), D3 (draft_state), D11 (events).
##
## Returns plain Dictionaries with the GDD field names. The default RunState
## satisfies every R1 invariant, and `validate_invariants` lists the ones a
## mutated fixture breaks. Layout helpers (`band_of`, `deck_size_at_floor`,
## `effective_treasure_floors`) are the GDD's own formulas so a test can state
## its expectation from the registry instead of a literal.
##
## The Dictionaries are the R1 JSON form, which is what Meta stores and what
## `RunRecord.to_dict` writes; [method to_run_state] is the road to the production
## `RunState`. `tests/helpers/run_harness.gd` drives the production `RunMachine`.
class_name RunFactory
extends RefCounted

## run-structure R1 `status` enum, in lifecycle order.
const STATUSES: Array[String] = ["hero_select", "pre_match", "in_match", "post_match_reward", "victory", "defeat", "abandoned"]
## Draft kinds (R1 `reward_step`, reward-draft D1).
const KIND_TREASURE: String = "treasure"
const KIND_BUNDLE: String = "bundle"
## reward-draft D11 `flags[]` vocabulary.
const OFFER_FLAGS: Array[String] = ["pity_forced", "coverage_forced", "universal_forced", "universal_missing", "reoffer", "short"]
## Fixture boss pool sizes per band (run-structure Acceptance Criteria: 6/6/4).
const FIXTURE_POOL_SIZES: Array[int] = [6, 6, 4]
const FIXTURE_BAND_PREFIXES: Array[String] = ["boss_a", "boss_b", "boss_c"]


# --- Layout formulas (run-structure F1, F4) ----------------------------------

## F1 `band(f)`: 1 for f ≤ s1, 2 for f ≤ s1 + s2, else 3.
static func band_of(floor: int, band_split: Array = TestConstants.BAND_SPLIT) -> int:
	if floor <= int(band_split[0]):
		return 1
	if floor <= int(band_split[0]) + int(band_split[1]):
		return 2
	return 3


## F1 `first_floor_of_band(b)`: 1, s1 + 1, s1 + s2 + 1.
static func first_floor_of_band(band: int, band_split: Array = TestConstants.BAND_SPLIT) -> int:
	match band:
		1:
			return 1
		2:
			return int(band_split[0]) + 1
		_:
			return int(band_split[0]) + int(band_split[1]) + 1


## F4 `deck_size(f) = starter_deck_size + bundle_card_count × (f − 1)`.
static func deck_size_at_floor(floor: int) -> int:
	return TestConstants.STARTER_DECK_SIZE + TestConstants.BUNDLE_CARD_COUNT * (floor - 1)


## Treasure floors below `floors_per_run` (registry note; Edge Cases "a
## treasure floor ≥ floors_per_run is ignored").
static func effective_treasure_floors(treasure_floors: Array = TestConstants.TREASURE_FLOORS, floors_per_run: int = TestConstants.FLOORS_PER_RUN) -> Array:
	var effective: Array = []
	for f: Variant in treasure_floors:
		if int(f) < floors_per_run:
			effective.append(int(f))
	return effective


## F4 `treasures_held(f) = |{t ∈ treasure_floors : t < f}|`.
static func treasures_held_at_floor(floor: int, treasure_floors: Array = TestConstants.TREASURE_FLOORS, floors_per_run: int = TestConstants.FLOORS_PER_RUN) -> int:
	var held: int = 0
	for f: Variant in effective_treasure_floors(treasure_floors, floors_per_run):
		if int(f) < floor:
			held += 1
	return held


# --- Fixtures ----------------------------------------------------------------

## The Acceptance Criteria boss pool: `boss_a1..a6` (band 1), `boss_b1..b6`
## (band 2), `boss_c1..c4` (band 3), as BossDefs with band-default health.
static func make_fixture_boss_pool() -> Array:
	var pool: Array = []
	for band_index: int in range(3):
		for i: int in range(1, FIXTURE_POOL_SIZES[band_index] + 1):
			pool.append(CardFactory.make_boss_def("%s%d" % [FIXTURE_BAND_PREFIXES[band_index], i], band_index + 1))
	return pool


## Card Database CR-6 `bosses_in_band(band)` over a pool: id-ascending.
static func bosses_in_band(pool: Array, band: int) -> Array:
	var found: Array = []
	for boss: Dictionary in pool:
		if int(boss.band) == band:
			found.append(boss)
	found.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return str(a.id) < str(b.id))
	return found


## A draw-free boss sequence of length `floors_per_run` from the fixture pool:
## the first `s_b` ids of each band in id order (F2's shape without the shuffle).
static func make_boss_sequence(band_split: Array = TestConstants.BAND_SPLIT) -> Array:
	var sequence: Array = []
	for band_index: int in range(3):
		for i: int in range(1, int(band_split[band_index]) + 1):
			var pool_index: int = ((i - 1) % FIXTURE_POOL_SIZES[band_index]) + 1
			sequence.append("%s%d" % [FIXTURE_BAND_PREFIXES[band_index], pool_index])
	return sequence


## A RunState (R1) at `pre_match` on floor 1 of a fresh run; every invariant
## holds. `overrides` replace top-level fields.
static func make_run_state(overrides: Dictionary = {}) -> Dictionary:
	var seed_value: int = int(overrides.get("run_seed", TestConstants.DEFAULT_TEST_SEED))
	var seed_hex: String = TestRngStream.to_hex_u64(seed_value)
	var state: Dictionary = {
		"schema_version": TestConstants.RUN_RECORD_SCHEMA_VERSION,
		"data_version": "test",
		"engine_version": "test-engine",
		"run_id": "%s-0" % seed_hex,
		"run_seed": seed_value,
		"run_seed_hex": seed_hex,
		"seed_source": "custom",
		"hero_id": "hero_war",
		"floors_per_run": TestConstants.FLOORS_PER_RUN,
		"band_split": TestConstants.BAND_SPLIT.duplicate(),
		"treasure_floors": TestConstants.TREASURE_FLOORS.duplicate(),
		"boss_sequence": make_boss_sequence(),
		"floor": 1,
		"status": "pre_match",
		"reward_step": null,
		"deck": CardFactory.make_starter_deck_ids("war"),
		"treasures": [],
		"drafts": [],
		"match_attempts": {},
		"match_summaries": [],
		"draft_state": {"schema_version": 1, "treasure_pool": []},
		"treasure_state": {"schema_version": 1, "by_treasure": {}},
		"rng_snapshot": {},
		"run_log": {},
		"started_at": 0,
		"updated_at": 0,
		"ended_at": null,
		"play_seconds": 0,
		"result": null,
		"totals": {},
	}
	state.merge(overrides, true)
	return state


## A DraftRecord (R1): `picked_id` null and `card_ids_added` [] mark a skipped step.
static func make_draft_record(floor: int, kind: String, offered_ids: Array, picked_id: Variant, card_ids_added: Array = []) -> Dictionary:
	return {
		"floor": floor,
		"kind": kind,
		"offered_ids": offered_ids.duplicate(),
		"picked_id": picked_id,
		"card_ids_added": card_ids_added.duplicate(),
	}


## Record a bundle pick on `run_state` the way R5.4 does: a DraftRecord plus
## the bundle's cards appended to `deck` (keeps the F4 invariant).
static func apply_bundle_pick(run_state: Dictionary, floor: int, offered_ids: Array, picked_id: String, card_ids: Array) -> void:
	run_state.drafts.append(make_draft_record(floor, KIND_BUNDLE, offered_ids, picked_id, card_ids))
	run_state.deck.append_array(card_ids)


## Record a treasure pick on `run_state` (R5.4): a DraftRecord plus the id
## appended to `treasures` in pick order.
static func apply_treasure_pick(run_state: Dictionary, floor: int, offered_ids: Array, picked_id: String) -> void:
	run_state.drafts.append(make_draft_record(floor, KIND_TREASURE, offered_ids, picked_id, []))
	run_state.treasures.append(picked_id)


## A reward-draft D1 `Offer {option_ids[], flags[]}`.
static func make_offer(option_ids: Array, flags: Array = []) -> Dictionary:
	return {"option_ids": option_ids.duplicate(), "flags": flags.duplicate()}


## A MatchSummary (rng-event-log `match_summary` plus R4's `boss_id, band,
## attempt, duration_s`).
static func make_match_summary(floor: int, result: String = "win", turns: int = 10, overrides: Dictionary = {}) -> Dictionary:
	var summary: Dictionary = {
		"floor": floor,
		"result": result,
		"turns": turns,
		"event_count": 0,
		"cards_played": 0,
		"damage_by_card": {},
		"boss_id": "",
		"band": band_of(floor),
		"attempt": 1,
		"duration_s": 0,
	}
	summary.merge(overrides, true)
	return summary


## [param run_state] as the production `RunState`, through `RunRecord.from_dict`.
static func to_run_state(run_state: Dictionary) -> RunState:
	return RunRecord.from_dict(run_state)


## R3's MatchConfig for the run's current floor, built through MatchFactory:
## player deck = `run_state.deck`, boss = `boss_sequence[floor - 1]`, and
## `hook_installers = treasures.installers_for(...)` in pick order, `[]` with no
## [param treasures].
static func make_match_config_for(run_state: Dictionary, rng: TestRngService = null, log: TestEventLog = null, treasures: Treasures = null) -> Dictionary:
	var floor: int = int(run_state.floor)
	var config: Dictionary = MatchFactory.make_match_config(floor, rng, log)
	config.band = band_of(floor, run_state.band_split)
	config.player.hero_def_id = run_state.hero_id
	config.player.deck = run_state.deck.duplicate()
	config.player.hook_installers = treasures.installers_for(run_state.treasures, run_state.treasure_state) if treasures != null else []
	config.boss.boss_def_id = run_state.boss_sequence[floor - 1]
	config.boss.health = MatchFactory.boss_health_for_band(config.band)
	return config


## The R1 invariants as a list of violations (empty = all hold). Observations
## for a test to assert on; the Card Database id check is out of scope here.
static func validate_invariants(run_state: Dictionary) -> Array:
	var problems: Array = []
	var floors: int = int(run_state.floors_per_run)
	if run_state.boss_sequence.size() != floors:
		problems.append("len(boss_sequence) %d != floors_per_run %d" % [run_state.boss_sequence.size(), floors])
	var split_sum: int = 0
	for s: Variant in run_state.band_split:
		split_sum += int(s)
	if split_sum != floors:
		problems.append("sum(band_split) %d != floors_per_run %d" % [split_sum, floors])
	if int(run_state.floor) < 1 or int(run_state.floor) > floors:
		problems.append("floor %d outside 1..%d" % [int(run_state.floor), floors])
	var bundle_picks: int = 0
	var treasure_picks: int = 0
	for draft: Dictionary in run_state.drafts:
		if draft.picked_id == null:
			continue
		if draft.kind == KIND_BUNDLE:
			bundle_picks += 1
		elif draft.kind == KIND_TREASURE:
			treasure_picks += 1
	var expected_deck: int = TestConstants.STARTER_DECK_SIZE + TestConstants.BUNDLE_CARD_COUNT * bundle_picks
	if run_state.deck.size() != expected_deck:
		problems.append("len(deck) %d != %d (starter + bundles × picks)" % [run_state.deck.size(), expected_deck])
	if run_state.treasures.size() != treasure_picks:
		problems.append("len(treasures) %d != treasure picks %d" % [run_state.treasures.size(), treasure_picks])
	if int(run_state.draft_state.get("schema_version", -1)) != 1:
		problems.append("draft_state.schema_version != 1")
	if int(run_state.treasure_state.get("schema_version", -1)) != 1:
		problems.append("treasure_state.schema_version != 1")
	return problems


## Assert every R1 invariant holds on `run_state`.
static func assert_invariants(run_state: Dictionary, label: String = "run_state") -> void:
	var problems: Array = validate_invariants(run_state)
	GameAssertions.fail_if(not problems.is_empty(), "%s breaks R1 invariants: %s" % [label, str(problems)])
