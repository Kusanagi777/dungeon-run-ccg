## Factory for Card Database records and Card Effects effect objects.
## Generated by /test-helpers on 2026-11-03.
## Based on: design/gdd/card-database.md CR-1..CR-4, design/gdd/card-effects.md C1.
##
## Returns plain Dictionaries with exactly the field names the GDDs specify, so
## a fixture built here is what the loader will read from `assets/data/*.json`
## and what `validate_card_def` can check. No scene tree, no production class.
##
## TODO(E1/E2 story): swap to the production CardDef / HeroDef / BossDef /
## TreasureDef / BundleDef types once Card Database exists.
class_name CardFactory
extends RefCounted

## card-database CR-2 id pattern
const ID_PATTERN: String = "^[a-z][a-z0-9_]{2,47}$"
## card-database CR-3 `set` enum
const SETS: Array[String] = ["war", "decay", "knowledge", "neutral", "boss", "fortune", "order", "shadow"]
## card-database CR-3 `type` enum (DD-M08)
const TYPES: Array[String] = ["minion", "spell", "weapon"]
## card-database CR-4 rarity: three tiers
const RARITIES: Array[String] = ["common", "rare", "legendary"]
## card-database CR-4 keyword id list (DD-M09, owned by Match Rules C12)
const KEYWORDS: Array[String] = [
	"taunt", "charge", "rush", "divine_shield", "windfury", "stealth", "lifesteal",
	"poisonous", "freeze", "silence", "battlecry", "deathrattle", "spell_damage",
	"discover", "aura",
]
## card-database CR-3 `cost` range (DD-M04)
const COST_MIN: int = 0
const COST_MAX: int = 10
## card-database CR-3 `spell_damage` range
const SPELL_DAMAGE_MAX: int = 5


## A CardDef (CR-3) with every required field; `overrides` replace defaults and
## the result is shaped by `type` (spells carry no attack/health/durability,
## weapons no health, minions no durability).
static func make_card_def(overrides: Dictionary = {}) -> Dictionary:
	var id: String = str(overrides.get("id", "neutral_test_card"))
	var def: Dictionary = {
		"id": id,
		"name": "Test Card",
		"set": "neutral",
		"type": "minion",
		"cost": 1,
		"attack": 1,
		"health": 1,
		"durability": 1,
		"rarity": "common",
		"keywords": [],
		"spell_damage": 0,
		"effects": [],
		"tags": [],
		"text": {"key": "card.%s.text" % id, "en": ""},
		"token": false,
		"art": "cards/%s" % id,
	}
	def.merge(overrides, true)
	return _shape_by_type(def)


## A vanilla or keyworded minion (CR-3 minion row).
static func make_minion(id: String, cost: int, attack: int, health: int, keywords: Array = [], overrides: Dictionary = {}) -> Dictionary:
	var fields: Dictionary = {"id": id, "type": "minion", "cost": cost, "attack": attack, "health": health, "keywords": keywords.duplicate()}
	fields.merge(overrides, true)
	return make_card_def(fields)


## A spell; `effects` is a list of card-effects C1 effect objects.
static func make_spell(id: String, cost: int, effects: Array = [], overrides: Dictionary = {}) -> Dictionary:
	var fields: Dictionary = {"id": id, "type": "spell", "cost": cost, "effects": effects.duplicate(true)}
	fields.merge(overrides, true)
	return make_card_def(fields)


## A weapon (CR-3 weapon row: attack and durability, no health).
static func make_weapon(id: String, cost: int, attack: int, durability: int, overrides: Dictionary = {}) -> Dictionary:
	var fields: Dictionary = {"id": id, "type": "weapon", "cost": cost, "attack": attack, "durability": durability}
	fields.merge(overrides, true)
	return make_card_def(fields)


## A card-effects C1 effect object. `targets` defaults to the trigger's default
## scope (absent); pass `{"selector": "chosen", "filter": {...}}` for a
## targeted play effect. `id` is left absent unless overridden (C1: default
## `<host_id>.<index>`).
static func make_effect(trigger: String, ops: Array, targets: Dictionary = {}, overrides: Dictionary = {}) -> Dictionary:
	var effect: Dictionary = {
		"trigger": trigger,
		"scope": {},
		"condition": {},
		"ops": ops.duplicate(true),
		"once_per_turn": false,
	}
	if not targets.is_empty():
		effect["targets"] = targets.duplicate(true)
	effect.merge(overrides, true)
	return effect


## One card-effects C5 operation: `{"op": name}` plus `fields`.
static func make_op(op: String, fields: Dictionary = {}) -> Dictionary:
	var out: Dictionary = {"op": op}
	out.merge(fields, true)
	return out


## A HeroDef (CR-3): 15-card starter deck by default, health from the registry.
static func make_hero_def(id: String = "hero_war", hero_set: String = "war", overrides: Dictionary = {}) -> Dictionary:
	var def: Dictionary = {
		"id": id,
		"name": "Test Hero",
		"set": hero_set,
		"health": TestConstants.PLAYER_STARTING_HEALTH,
		"hero_power": "power_test",
		"starter_deck": make_starter_deck_ids(hero_set),
		"unlock": null,
		"text": {"key": "hero.%s.text" % id, "en": ""},
		"art": "heroes/%s" % id,
	}
	def.merge(overrides, true)
	return def


## Exactly `STARTER_DECK_SIZE` CR-2-valid ids for `hero_set` (DD-R03).
static func make_starter_deck_ids(hero_set: String = "war") -> Array:
	var ids: Array = []
	for i: int in range(1, TestConstants.STARTER_DECK_SIZE + 1):
		ids.append("%s_starter_%02d" % [hero_set, i])
	return ids


## A HeroPowerDef (CR-3): cost defaults to the registry `hero_power_cost`.
static func make_hero_power_def(id: String = "power_test", effects: Array = [], overrides: Dictionary = {}) -> Dictionary:
	var def: Dictionary = {
		"id": id,
		"name": "Test Power",
		"cost": TestConstants.HERO_POWER_COST,
		"effects": effects.duplicate(true),
		"text": {"key": "power.%s.text" % id, "en": ""},
		"art": "powers/%s" % id,
	}
	def.merge(overrides, true)
	return def


## A BossDef (CR-3): health defaults to the band default (DD-M02), passive
## null and therefore no `passive_text` (CR-3: absent when passive is null).
static func make_boss_def(id: String, band: int, overrides: Dictionary = {}) -> Dictionary:
	var def: Dictionary = {
		"id": id,
		"name": "Test Boss",
		"band": band,
		"health": TestConstants.BOSS_STARTING_HEALTH_BY_BAND[clampi(band, 1, 3) - 1],
		"hero_power": "power_test",
		"passive": null,
		"deck": ["boss_test_card"],
		"ai_profile": "default",
		"tags": [],
		"intro_text": {"key": "boss.%s.intro" % id, "en": ""},
		"art": "bosses/%s" % id,
	}
	def.merge(overrides, true)
	if def.passive != null and not def.has("passive_text"):
		def["passive_text"] = {"key": "boss.%s.passive" % id, "en": ""}
	return def


## A TreasureDef (CR-3): v1 rarity `common | rare`, one affinity tag first.
static func make_treasure_def(id: String, rarity: String = "common", tags: Array = ["universal"], overrides: Dictionary = {}) -> Dictionary:
	var def: Dictionary = {
		"id": id,
		"name": "Test Treasure",
		"rarity": rarity,
		"tags": tags.duplicate(),
		"effects": [],
		"unlock": null,
		"text": {"key": "treasure.%s.text" % id, "en": ""},
		"art": "treasures/%s" % id,
	}
	def.merge(overrides, true)
	return def


## A BundleDef (CR-3): exactly `BUNDLE_CARD_COUNT` card ids sharing `theme`.
static func make_bundle_def(id: String, bundle_set: String, theme: String, cards: Array, overrides: Dictionary = {}) -> Dictionary:
	var def: Dictionary = {
		"id": id,
		"name": "Test Bundle",
		"set": bundle_set,
		"theme": theme,
		"cards": cards.duplicate(),
		"text": {"key": "bundle.%s.text" % id, "en": ""},
	}
	def.merge(overrides, true)
	return def


## CR-1 definition-file envelope `{schema_version, records}`.
static func make_definition_file(records: Array, schema_version: int = TestConstants.SCHEMA_VERSION_CURRENT) -> Dictionary:
	return {"schema_version": schema_version, "records": records.duplicate(true)}


## CR-1 config-file envelope `{schema_version, config}`.
static func make_config_file(config: Dictionary, schema_version: int = TestConstants.SCHEMA_VERSION_CURRENT) -> Dictionary:
	return {"schema_version": schema_version, "config": config.duplicate(true)}


## The match-rules Acceptance Criteria fixture set: vanilla minions, one minion
## per combat keyword, a 2/2 weapon, a 1-damage spell and a "draw 2" spell.
## All `neutral`, all CR-2-valid ids, no tokens.
static func make_fixture_card_set() -> Array:
	var cards: Array = [
		make_minion("neutral_test_vanilla_1_1", 1, 1, 1),
		make_minion("neutral_test_vanilla_2_2", 2, 2, 2),
		make_minion("neutral_test_vanilla_3_4", 3, 3, 4),
		make_minion("neutral_test_vanilla_2_5", 4, 2, 5),
	]
	for keyword: String in ["taunt", "charge", "rush", "divine_shield", "windfury", "stealth", "lifesteal", "poisonous"]:
		cards.append(make_minion("neutral_test_%s" % keyword, 2, 2, 2, [keyword]))
	cards.append(make_weapon("neutral_test_weapon_2_2", 2, 2, 2))
	cards.append(make_spell("neutral_test_bolt", 1, [
		make_effect("cast", [make_op("damage", {"amount": 1})], {"selector": "chosen", "filter": {"kind": "any"}}),
	]))
	cards.append(make_spell("neutral_test_draw_two", 2, [
		make_effect("cast", [make_op("draw", {"count": 2})]),
	]))
	return cards


## True when `id` matches CR-2.
static func is_valid_id(id: String) -> bool:
	return RegEx.create_from_string(ID_PATTERN).search(id) != null


## Light CR-3 shape check. Returns a list of problems (empty = clean) so a test
## decides what to do with them; it is an observation, not a verdict.
static func validate_card_def(def: Dictionary) -> Array:
	var problems: Array = []
	var id: String = str(def.get("id", ""))
	if not is_valid_id(id):
		problems.append("id '%s' violates CR-2" % id)
	if not SETS.has(str(def.get("set", ""))):
		problems.append("set '%s' not in CR-3 enum" % str(def.get("set", "")))
	var type: String = str(def.get("type", ""))
	if not TYPES.has(type):
		problems.append("type '%s' not in CR-3 enum" % type)
	var cost: int = int(def.get("cost", -1))
	if cost < COST_MIN or cost > COST_MAX:
		problems.append("cost %d outside %d..%d" % [cost, COST_MIN, COST_MAX])
	if not RARITIES.has(str(def.get("rarity", ""))):
		problems.append("rarity '%s' not in CR-4" % str(def.get("rarity", "")))
	var seen: Dictionary = {}
	for keyword: Variant in def.get("keywords", []):
		if not KEYWORDS.has(str(keyword)):
			problems.append("keyword '%s' not in DD-M09 list" % str(keyword))
		if seen.has(keyword):
			problems.append("keyword '%s' repeated" % str(keyword))
		seen[keyword] = true
	match type:
		"minion":
			if not def.has("attack") or not def.has("health") or def.has("durability"):
				problems.append("minion must carry attack and health, never durability")
			elif int(def.health) < 1:
				problems.append("minion health %d below 1" % int(def.health))
		"spell":
			if def.has("attack") or def.has("health") or def.has("durability"):
				problems.append("spell must not carry attack, health or durability")
		"weapon":
			if not def.has("attack") or not def.has("durability") or def.has("health"):
				problems.append("weapon must carry attack and durability, never health")
			elif int(def.durability) < 1:
				problems.append("weapon durability %d below 1" % int(def.durability))
	var text: Dictionary = def.get("text", {})
	if str(text.get("key", "")) != "card.%s.text" % id:
		problems.append("text.key must be card.%s.text" % id)
	if int(def.get("spell_damage", 0)) > 0 and not def.get("keywords", []).has("spell_damage"):
		problems.append("spell_damage > 0 without the spell_damage keyword")
	return problems


static func _shape_by_type(def: Dictionary) -> Dictionary:
	match str(def.get("type", "")):
		"spell":
			def.erase("attack")
			def.erase("health")
			def.erase("durability")
		"weapon":
			def.erase("health")
		_:
			def.erase("durability")
	return def
