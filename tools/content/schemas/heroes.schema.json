{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heroes.schema.json",
  "title": "heroes.json — HeroDef records (card-database CR-3)",
  "description": "Agrees with the loader (src/core/data/record_schemas.gd), never replaces it (ADR-0002 Decision 9). tests/integration/content/content_validate_process_test.gd compares required/properties with RecordSchemas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "set",
          "health",
          "hero_power",
          "starter_deck",
          "unlock",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,47}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "set": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "health": {
            "type": "integer",
            "minimum": 1
          },
          "hero_power": {
            "type": "string",
            "minLength": 1
          },
          "extra_powers": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2
          },
          "starter_deck": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,47}$"
            },
            "minItems": 15,
            "maxItems": 15
          },
          "unlock": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "key",
              "condition"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "condition": {
                "type": "object"
              }
            }
          },
          "text": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "en"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "art": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
